            "met": 5.5,
            "durationSecPerSet": 50,
            "notes": "Focus on symmetry — do not shift right. Use mirror. Stop before anterior pinch."
          },
          {
            "id": "mon-m-stepup",
            "name": "Dumbbell Step-Up (Low Box)",
            "targetSets": 3,
            "targetReps": "8 each leg",
