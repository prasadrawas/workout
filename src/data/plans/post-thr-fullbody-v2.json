            "targetReps": "15 per foot",
            "defaultRestSec": 30,
            "category": "hip-rehab",
            "met": 1.5,
            "durationSecPerSet": 30,
            "notes": "Builds intrinsic foot muscles and arch stability. Foundation for ankle stability."
          }
        ]
      }
