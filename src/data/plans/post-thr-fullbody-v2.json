            "isTimeBased": true,
            "rightHipFocus": true,
            "met": 2.5,
            "durationSecPerSet": 30,
            "notes": "Near wall for safety. Eyes open first. Targets right ankle proprioception + wobble control. Progress: eyes closed → foam pad."
          },
