            "rightHipFocus": true,
            "met": 2.3,
            "durationSecPerSet": 30,
            "notes": "Works toward cross-legged sitting goal. Do not force right side. Gentle progressive stretch on deep external rotators."
          },
          {
            "id": "mon-e-ql-stretch",
            "name": "Side-Lying QL Stretch (Right Side Up)",
            "targetSets": 2,
            "targetReps": "30s hold",
            "defaultRestSec": 15,
